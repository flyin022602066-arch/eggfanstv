  "upload_chain": {
    "prepare_upload_response": {
      "service_id": "data.service_id",
      "upload_host": "data.upload_host",
      "ak": "data.upload_auth_token.access_key",
      "sk": "data.upload_auth_token.secret_key",
      "token": "data.upload_auth_token.session_token"
    },
    "ApplyImageUpload": {
      "method": "GET",
      "url": "https://<upload_host>/",
      "query": {
        "Action": "ApplyImageUpload",
        "Version": "2018-08-01",
        "ServiceId": "<service_id>",
        "NeedFallback": "true",
        "UploadNum": "1",
        "FileSize": "<bytes>",
        "FileExtension": "<dot-prefixed extension>"
      },
      "headers": [
        "x-amz-date",
        "x-amz-security-token",
        "X-Security-Token",
        "authorization",
        "User-Agent"
      ],
      "response_fields": [
        "Result.UploadAddress.StoreInfos[0].StoreUri",
        "Result.UploadAddress.StoreInfos[0].Auth",
        "Result.UploadAddress.UploadHosts[0]"
      ]
    },
    "TOS": {
      "method": "POST",
      "url": "https://<tos_host>/upload/v1/<StoreUri>",
      "body": "raw file bytes",
      "headers": {
        "Authorization": "<StoreInfos[0].Auth>",
        "Content-CRC32": "<crc32 unsigned as 8 hex digits>",
        "Content-Type": "<image mime>",
        "User-Agent": "<UA>"
      }
    },
    "CommitImageUpload": {
      "method": "POST",
      "url": "https://<upload_host>/",
      "query": {
        "Action": "CommitImageUpload",
        "Version": "2018-08-01",
        "ServiceId": "<service_id>"
      },
      "body": {
        "SessionKey": "<base64(UTF8(JSON compact of session_key_object)))>"
      },
      "headers": [
        "x-amz-date",
        "x-amz-security-token",
        "x-amz-content-sha256",
        "content-type",
        "authorization",
        "User-Agent"
      ],
      "signing": "temporary STS credentials + AWS4 HMAC SHA256; dynamic, never hardcode credentials",
      "session_key_object": {
        "accountType": "ImageX",
        "appId": "",
        "bizType": "",
        "fileType": "image",
        "legal": "",
        "storeInfos": "<JSON compact string of [{StoreUri,Auth,UploadID:'',UploadHeader:null,StorageHeader:null}]>",
        "uploadHost": "<tos_host>",
        "uri": "<store_uri>",
        "userId": ""
      }
    },
    "note": "This is the direct upload implementation. The generation path also uses browser upload/capture; no live upload was performed."
  },
